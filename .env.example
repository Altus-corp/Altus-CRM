# PostgreSQL connection string for the local crm_dev database.
CRM_PG_URL=
# Optional path to the Supabase project root CA certificate for certificate verification.
CRM_PG_CA_CERT=
# Owner email used by the owner-seeding workflow.
CRM_OWNER_EMAIL=
# Owner password used by the owner-seeding workflow.
CRM_OWNER_PASSWORD=
# API server port; defaults to 4321.
CRM_PORT=
# API server bind host; defaults to 127.0.0.1. Set to 0.0.0.0 only when sharing on a LAN.
CRM_HOST=
# Vite dev-server proxy target; defaults to the API on this machine.
VITE_API_PROXY_TARGET=
# Static build directory served by the Node server.
CRM_STATIC=
# Set to 1 when running behind a trusted proxy.
CRM_BEHIND_PROXY=
# Public URL used for HTTPS-aware security behavior.
CRM_PUBLIC_URL=
# Comma-separated trusted proxy addresses.
CRM_TRUSTED_PROXIES=
# Server-only Resend configuration for password reset email delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Altus CRM <noreply@crm.altuscorp.in>
APP_BASE_URL=https://crm.altuscorp.in
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# PostgreSQL connection string for the import database.
CRM_IMPORT_PG_URL=
# Owner role used by the owner-seeding workflow.
CRM_OWNER_ROLE=
# Owner display name used by the owner-seeding workflow.
CRM_OWNER_NAME=
# Set to 1 only for an explicitly approved Supabase write process.
ALLOW_SUPABASE_WRITE=
# Operator label recorded for approved script write runs.
CRM_OPERATOR=
# Set to 1 only for an explicitly approved production write process.
ALLOW_PRODUCTION_WRITE=
